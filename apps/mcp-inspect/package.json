{
  "name": "@ai-agents-demo/mcp-inspect",
  "version": "0.0.1",
  "private": true,
  "description": "Read-only inspect MCP server (Phase 1: canned sample data; real K8s API integration in Phase 2).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
