    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@ai-agents-demo/a2a-helpers": "workspace:*",
    "@ai-agents-demo/agent-runtime": "workspace:*",
    "@ai-agents-demo/auth-curity": "workspace:*",
    "@ai-agents-demo/otel-bootstrap": "workspace:*",
    "@ai-agents-demo/spiffe": "workspace:*",
    "@ai-sdk/anthropic": "^1.0.6",
    "ai": "^4.0.21",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
