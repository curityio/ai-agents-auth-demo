{
  "name": "@ai-agents-demo/agent-copilot",
  "version": "0.0.1",
  "private": true,
  "description": "Frontline incident-response copilot agent. Phase 1: single agent, Vercel AI SDK, forwards user JWT to MCP.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
