# Copy to .demo.env and fill in. .demo.env is gitignored; this file is not, so
# never put a real key here.
#
# Switching provider is this file plus `make configure-llm` — nothing else in the
# repo is provider-specific.

# openai | anthropic | gemini | azure | local
# azure is the default — it is the provider this demo is developed against. azure
# and anthropic are verified end to end; openai and gemini are schema-validated
# only. local = an OpenAI-compatible server on this machine (Ollama by default);
# it needs no key. For any other provider, delete the AZURE_OPENAI_ENDPOINT line
# at the bottom.
LLM_PROVIDER=azure

# Must be a model the provider above actually serves. A mismatch validates fine
# and fails at request time with the vendor's own error.
#   openai     gpt-4.1
#   anthropic  claude-sonnet-4-6
#   gemini     gemini-2.5-pro
#   local      qwen2.5:7b (must support tool calling; `ollama pull qwen2.5:7b`)
#   azure      the DEPLOYMENT name in your Azure resource, not the base model.
#              On Azure AI Foundry one resource serves both, e.g. claude-sonnet-4-6
#              or gpt-4.1; a Claude deployment's name must start with "claude".
LLM_MODEL=claude-sonnet-4-6

# The one upstream LLM credential in the system. It lives only in the
# agentgateway pod; the agents never hold it. Not needed for local.
LLM_API_KEY=

# local only. host:port the GATEWAY POD reaches the server at, plain HTTP, no
# scheme or path. host.docker.internal is the Docker host on Docker Desktop;
# localhost would be the pod itself and is refused. Default if omitted:
# LLM_LOCAL_HOST=host.docker.internal:11434

# azure only. Its host picks the Azure resource type:
#   Azure AI Foundry (GPT + Claude) — the PROJECT endpoint the Foundry portal shows:
#     https://<resource>.services.ai.azure.com/api/projects/<project>
#   Azure OpenAI (GPT only):
#     https://<resource>.openai.azure.com
# Required while LLM_PROVIDER=azure; delete it for any other provider.
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
