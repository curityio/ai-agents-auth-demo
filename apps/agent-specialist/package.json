{
  "name": "@ai-agents-demo/agent-specialist",
  "version": "0.0.1",
  "private": true,
  "description": "LLM-driven privileged remediation specialist. Accepts an A2A request carrying an agent-specialist-aud Bearer, inspects deployments (obs:read) and remediates them — restart, set image, scale — via mcp-ops (ops:write), with MFA step-up enforced before any write.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@ai-agents-demo/a2a-helpers": "workspace:*",
    "@ai-agents-demo/agent-runtime": "workspace:*",
    "@ai-agents-demo/auth-curity": "workspace:*",
    "@ai-agents-demo/otel-bootstrap": "workspace:*",
    "@ai-agents-demo/spiffe": "workspace:*",
    "ai": "^7.0.55",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "uuid": "^11.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
