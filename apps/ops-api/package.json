{
  "name": "@ai-agents-demo/ops-api",
  "version": "0.0.1",
  "private": true,
  "description": "Phase 4c privileged backend API. Terminal resource server: re-validates an ops-api-audience token (scope ops:write, acr=mfa, depth-3 act chain incl. mcp-ops) and performs the real K8s deployment restart. Owns the prod-namespace RBAC moved out of mcp-ops.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@ai-agents-demo/auth-curity": "workspace:*",
    "@ai-agents-demo/otel-bootstrap": "workspace:*",
    "@ai-agents-demo/spiffe": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@kubernetes/client-node": "^0.22.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
