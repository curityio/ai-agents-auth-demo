{
  "name": "@ai-agents-demo/a2a-helpers",
  "version": "0.0.1",
  "private": true,
  "description": "Thin wrapper over @a2a-js/sdk for the demo. Owns auth-context forwarding so an SDK pivot is a one-file change.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "express": "^4.21.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
